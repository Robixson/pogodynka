
<form method="post"
      action="{{ path('app_measurement_delete', {'id': measurement.id}) }}"
      onsubmit="return confirm('Czy na pewno chcesz usunąć ten pomiar?');">

    <input type="hidden" name="_token"
           value="{{ csrf_token('delete' ~ measurement.id) }}">

    <button type="submit" class="btn btn-outline-danger">
        Usuń pomiar
    </button>
</form>
