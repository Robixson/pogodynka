
{% extends 'base.html.twig' %}

{% block title %}Szczegóły pomiaru - Pogodynka{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <div class="mb-4">
                <a href="{{ path('app_measurement_index') }}"
                   class="btn btn-outline-secondary btn-sm mb-3">
                    &larr; Powrót do pomiarów
                </a>

                <h2 class="fw-bold mb-1">Szczegóły pomiaru</h2>
                <p class="text-muted mb-0">
                    Informacje o wybranym pomiarze pogodowym.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">Dane pomiaru</h5>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0 align-middle">
                            <tbody>
                            <tr>
                                <th class="ps-4" scope="row">ID</th>
                                <td>{{ measurement.id }}</td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Nazwa pomiaru</th>
                                <td>{{ measurement.measurementName }}</td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Lokalizacja</th>
                                <td>
                                    {% if measurement.location %}
                                        {{ measurement.location.city }}
                                    {% else %}
                                        Brak lokalizacji
                                    {% endif %}
                                </td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Data</th>
                                <td>
                                    {{ measurement.date ? measurement.date|date('d.m.Y') : '-' }}
                                </td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Temperatura</th>
                                <td>{{ measurement.celsius }} °C</td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Ciśnienie</th>
                                <td>{{ measurement.pressure }} hPa</td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Prędkość wiatru</th>
                                <td>{{ measurement.windSpeed }} m/s</td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Zachmurzenie</th>
                                <td>{{ measurement.cloudiness }} %</td>
                            </tr>

                            <tr>
                                <th class="ps-4" scope="row">Wilgotność</th>
                                <td>{{ measurement.humidity }} %</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a href="{{ path('app_measurement_index') }}"
                   class="btn btn-outline-secondary">
                    Powrót do listy
                </a>

                {% if is_granted('ROLE_MEASUREMENT_EDIT') %}
                    <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}"
                       class="btn btn-primary">
                        Edytuj pomiar
                    </a>
                {% endif %}
            </div>

            {% if is_granted('ROLE_MEASUREMENT_DELETE') %}
                <div class="card border-danger mt-4">
                    <div class="card-body">
                        <h5 class="text-danger">Usuń pomiar</h5>
                        <p class="text-muted small">
                            Usunięcie pomiaru jest nieodwracalne.
                        </p>

                        {{ include('measurement/_delete_form.html.twig') }}
                    </div>
                </div>
            {% endif %}

        </div>
    </div>
{% endblock %}
