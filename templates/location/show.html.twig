
{% extends 'base.html.twig' %}

{% block title %}Szczegóły lokalizacji - Pogodynka{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <div class="mb-4">
                <a href="{{ path('app_location_index') }}"
                   class="btn btn-outline-secondary btn-sm mb-3">
                    &larr; Powrót do lokalizacji
                </a>

                <h2 class="fw-bold mb-1">
                    {{ location.city }}
                </h2>
                <p class="text-muted mb-0">
                    Szczegółowe informacje o lokalizacji
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">Dane lokalizacji</h5>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0 align-middle">
                            <tbody>
                            <tr>
                                <th class="ps-4" scope="row">ID</th>
                                <td>{{ location.id }}</td>
                            </tr>
                            <tr>
                                <th class="ps-4" scope="row">Miasto</th>
                                <td>{{ location.city }}</td>
                            </tr>
                            <tr>
                                <th class="ps-4" scope="row">Państwo</th>
                                <td>{{ location.country }}</td>
                            </tr>
                            <tr>
                                <th class="ps-4" scope="row">
                                    Szerokość geograficzna
                                </th>
                                <td>{{ location.latitude }}</td>
                            </tr>
                            <tr>
                                <th class="ps-4" scope="row">
                                    Długość geograficzna
                                </th>
                                <td>{{ location.longitude }}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a href="{{ path('app_location_index') }}"
                   class="btn btn-outline-secondary">
                    Powrót do listy
                </a>

                {% if is_granted('ROLE_LOCATION_EDIT') %}
                    <a href="{{ path('app_location_edit', {'id': location.id}) }}"
                       class="btn btn-primary">
                        Edytuj lokalizację
                    </a>
                {% endif %}
            </div>

            {% if is_granted('ROLE_LOCATION_DELETE') %}
                <div class="mt-4">
                    {{ include('location/_delete_form.html.twig') }}
                </div>
            {% endif %}

        </div>
    </div>
{% endblock %}
