
{% extends 'base.html.twig' %}

{% block title %}Edytuj lokalizację - Pogodynka{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">

            <div class="mb-4">
                <a href="{{ path('app_location_index') }}"
                   class="btn btn-outline-secondary btn-sm mb-3">
                    &larr; Powrót do lokalizacji
                </a>

                <h2 class="fw-bold mb-1">Edytuj lokalizację</h2>
                <p class="text-muted">
                    Zmień dane lokalizacji i zapisz formularz.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    {{ include('location/_form.html.twig', {
                        'button_label': 'Zapisz zmiany'
                    }) }}
                </div>
            </div>

            {% if is_granted('ROLE_LOCATION_DELETE') %}
                <div class="card border-danger mt-4">
                    <div class="card-body">
                        <h5 class="text-danger">Usuń lokalizację</h5>
                        <p class="text-muted small">
                            Usunięcie lokalizacji może być nieodwracalne.
                        </p>

                        {{ include('location/_delete_form.html.twig') }}
                    </div>
                </div>
            {% endif %}

        </div>
    </div>
{% endblock %}
