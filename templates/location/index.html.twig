
{% extends 'base.html.twig' %}

{% block title %}Lista lokalizacji{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Lista lokalizacji</h1>

        {# Widok desktopowy - tabela #}
        <div class="d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Miasto</th>
                        <th>Kraj</th>
                        <th>Szerokość</th>
                        <th>Długość</th>
                        <th>Województwo</th>
                        <th>Akcje</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for location in locations %}
                        <tr>
                            <td>{{ location.id }}</td>
                            <td>{{ location.city }}</td>
                            <td>{{ location.country }}</td>
                            <td>{{ location.latitude }}</td>
                            <td>{{ location.longitude }}</td>
                            <td>{{ location.province }}</td>
                            <td>
                                {% if is_granted('ROLE_LOCATION_SHOW') %}
                                <a class="btn btn-sm btn-primary mb-1"
                                   href="{{ path('app_location_show', {'id': location.id}) }}">
                                    Pokaż
                                </a>
                                {% endif %}
                                {% if is_granted('ROLE_LOCATION_EDIT') %}
                                <a class="btn btn-sm btn-warning mb-1"
                                   href="{{ path('app_location_edit', {'id': location.id}) }}">
                                    Edytuj
                                </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">Brak lokalizacji.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Widok mobilny - karty #}
        <div class="d-md-none">
            {% for location in locations %}
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-dark text-white">
                        <strong>{{ location.city }}</strong>
                    </div>

                    <div class="card-body">
                        <p class="mb-2">
                            <strong>ID:</strong> {{ location.id }}
                        </p>
                        <p class="mb-2">
                            <strong>Kraj:</strong> {{ location.country }}
                        </p>
                        <p class="mb-2">
                            <strong>Szerokość geograficzna:</strong>
                            {{ location.latitude }}
                        </p>
                        <p class="mb-2">
                            <strong>Długość geograficzna:</strong>
                            {{ location.longitude }}
                        </p>
                        <p class="mb-3">
                            <strong>Województwo:</strong>
                            {{ location.province }}
                        </p>
                        {% if is_granted('ROLE_LOCATION_SHOW') %}
                        <a class="btn btn-primary btn-sm"
                           href="{{ path('app_location_show', {'id': location.id}) }}">
                            Pokaż
                        </a>
                        {% endif %}
                        {% if is_granted('ROLE_LOCATION_EDIT') %}
                        <a class="btn btn-warning btn-sm"
                           href="{{ path('app_location_edit', {'id': location.id}) }}">
                            Edytuj
                        </a>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info">
                    Brak lokalizacji.
                </div>
            {% endfor %}
        </div>

        {% if is_granted('ROLE_LOCATION_NEW') %}
            <a href="{{ path('app_location_new') }}" class="btn btn-success mt-2">
                + Dodaj lokalizację
            </a>
        {% endif %}
    </div>
{% endblock %}
