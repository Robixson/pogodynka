
<form method="post"
      action="{{ path('app_location_delete', {'id': location.id}) }}"
      onsubmit="return confirm('Czy na pewno chcesz usunąć tę lokalizację?');">

    <input type="hidden" name="_token"
           value="{{ csrf_token('delete' ~ location.id) }}">

    <button type="submit" class="btn btn-outline-danger">
        Usuń lokalizację
    </button>
</form>
