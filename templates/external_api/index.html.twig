{% extends 'base.html.twig' %}

{% block title %}Prognoza pogody - Open-Meteo{% endblock %}

{% block body %}
    <h1>Prognoza pogody - Open-Meteo</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}

    <button type="submit" class="btn btn-primary">
        Pobierz prognozę
    </button>
    {{ form_end(form) }}

    {% if weatherData is not empty %}
        <h2 class="mt-4">Prognoza pogody</h2>

        <table class="table table-striped table-bordered">
            <thead>
            <tr>
                <th>Data</th>
                <th>Temperatura maksymalna (°C)</th>
                <th>Temperatura minimalna (°C)</th>
                <th>Suma opadów (mm)</th>
            </tr>
            </thead>

            <tbody>
            {% for date in weatherData.daily.time %}
                <tr>
                    <td>{{ date }}</td>
                    <td>{{ weatherData.daily.temperature_2m_max[loop.index0] }}</td>
                    <td>{{ weatherData.daily.temperature_2m_min[loop.index0] }}</td>
                    <td>{{ weatherData.daily.precipitation_sum[loop.index0] }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
