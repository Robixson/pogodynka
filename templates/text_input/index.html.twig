{% extends 'base.html.twig' %}

{% block title %}Formularz tekstowy{% endblock %}

{% block body %}
    <h1>Formularz tekstowy</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn btn-primary">
        Wyślij
    </button>
    {{ form_end(form) }}

    {% if submittedText is not empty %}
        <h2>Wprowadzony tekst:</h2>
        <p>{{ submittedText }}</p>
        <p>{{ submittedText|raw }}</p>
    {% endif %}
{% endblock %}
